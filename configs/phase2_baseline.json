{
  "data": {
    "train_tokens": "experiments/data/phase0_real_language/mindforge.train.npy",
    "validation_tokens": "experiments/data/phase0_real_language/mindforge.validation.npy",
    "tokenizer": "experiments/data/phase0_real_language/mindforge-tokenizer.json",
    "run_dir": "runs/phase2-lr-sweep/baseline"
  },
  "model": {
    "vocab_size": 16384,
    "d_model": 320,
    "n_heads": 8,
    "n_layers": 4,
    "max_context": 512,
    "ff_mult": 4,
    "dropout": 0.0
  },
  "training": {
    "steps": 200,
    "micro_batch": 1,
    "accumulation": 2,
    "learning_rate": 3e-4,
    "weight_decay": 0.1,
    "gradient_clip": 1.0,
    "warmup_fraction": 0.05,
    "min_lr_fraction": 0.1,
    "eval_interval": 50,
    "checkpoint_interval": 100,
    "eval_windows": 8,
    "seed": 101,
    "device": "xpu",
    "dtype": "bfloat16"
  }
}
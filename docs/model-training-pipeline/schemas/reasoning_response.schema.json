{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReasoningResponse",
  "type": "object",
  "required": [
    "reasoning",
    "answer",
    "reasoning_kind"
  ],
  "properties": {
    "reasoning": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "reasoning_kind": {
      "const": "model_generated_rationale"
    },
    "runtime": {
      "type": "string"
    },
    "model_artifact": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_contract.schema.json",
  "title": "EvaluationContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_set_id", "fixture_set_hash", "baseline_registry_hash",
    "metrics", "inference_contract"
  ],
  "properties": {
    "fixture_set_id": {"type": "string", "minLength": 1},
    "fixture_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id", "metric_version", "target_artifact", "baseline_id",
          "comparison_type", "operator", "threshold", "aggregation",
          "required", "missing_data_policy"
        ],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "metric_version": {"type": "string", "minLength": 1},
          "target_artifact": {"type": "string", "minLength": 1},
          "baseline_id": {"type": "string", "minLength": 1},
          "comparison_type": {"enum": ["absolute_value", "absolute_delta", "relative_delta", "ratio", "distribution_test"]},
          "operator": {"enum": [">", ">=", "<", "<=", "=="]},
          "threshold": {"type": "number"},
          "aggregation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "method"],
            "properties": {
              "unit": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1}
            }
          },
          "required": {"type": "boolean"},
          "missing_data_policy": {"enum": ["fail", "invalid", "ignore_optional"]}
        }
      }
    },
    "inference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_tokens", "temperature", "top_p", "top_k", "seed", "context_length", "stream"],
      "properties": {
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "top_k": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"},
        "context_length": {"type": "integer", "minimum": 64},
        "stream": {"type": "boolean"}
      }
    }
  }
}

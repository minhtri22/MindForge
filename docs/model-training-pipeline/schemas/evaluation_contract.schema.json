{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_contract.schema.json",
  "title": "EvaluationContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_set_id", "fixture_set_hash", "metrics", "inference_contract"],
  "properties": {
    "fixture_set_id": {"type": "string", "minLength": 1},
    "fixture_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id", "metric_version", "target_artifact", "baseline_id",
          "comparison_type", "operator", "threshold", "aggregation", "required"
        ],
        "properties": {
          "metric_id": {"type": "string"},
          "metric_version": {"type": "string"},
          "target_artifact": {"type": "string"},
          "baseline_id": {"type": "string"},
          "comparison_type": {"enum": ["absolute_value", "absolute_delta", "relative_delta", "ratio", "distribution_test"]},
          "operator": {"enum": [">", ">=", "<", "<=", "=="]},
          "threshold": {"type": "number"},
          "aggregation": {"type": "object"},
          "required": {"type": "boolean"},
          "missing_data_policy": {"enum": ["fail", "invalid", "ignore_optional"]}
        }
      }
    },
    "inference_contract": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment_config.schema.json",
  "title": "ExperimentConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "model", "datasets", "phases", "baselines", "evaluation", "reasoning", "export"],
  "properties": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["smoke", "development", "calibration", "confirmatory", "release"]},
        "seed_sets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "development": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            "calibration": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            "fresh_confirmatory": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "revision", "require_resolved_sha", "profile"],
      "properties": {
        "source": {"enum": ["huggingface", "local_hf"]},
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "require_resolved_sha": {"const": true},
        "allow_remote_code": {"type": "boolean", "default": false},
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/dataset"}
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/baseline"}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_set", "metrics", "inference"],
      "properties": {
        "fixture_set": {"type": "string", "minLength": 1},
        "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
        "inference": {"$ref": "#/$defs/inference"}
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "transport_preference", "fallback_transport"],
      "properties": {
        "mode": {"enum": ["visible", "hidden", "off"]},
        "transport_preference": {"enum": ["native_runtime_field", "tagged_text"]},
        "fallback_transport": {"enum": ["none", "tagged_text"]},
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "minLength": 1},
            "end": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hf", "gguf", "verify_llama_cpp", "verify_ollama"],
      "properties": {
        "hf": {"type": "boolean"},
        "gguf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high_fidelity", "quantize"],
          "properties": {
            "high_fidelity": {"enum": ["preserve_source", "f16", "bf16"]},
            "quantize": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "verify_llama_cpp": {"type": "boolean"},
        "verify_ollama": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "required": ["adapter", "snapshot", "freshness_class"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "snapshot": {"type": "string", "minLength": 1},
        "freshness_class": {"enum": ["development", "calibration", "fresh_confirmatory"]}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "parent_ref", "datasets", "token_stream", "stop",
        "optimizer_transition", "scheduler_transition", "checkpoint_selection", "training"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["cpt", "sft", "reasoning_sft", "lora_sft"]},
        "parent_ref": {"type": "string", "pattern": "^(model|phase:[A-Za-z0-9_.-]+|artifact:.+)$"},
        "datasets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "token_stream": {"$ref": "#/$defs/tokenStream"},
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["max_steps", "max_tokens", "max_epochs"]},
            "value": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "optimizer_transition": {"enum": ["reset", "carry"]},
        "scheduler_transition": {"enum": ["reset", "carry"]},
        "checkpoint_selection": {"$ref": "#/$defs/checkpointSelection"},
        "training": {"$ref": "#/$defs/training"}
      }
    },
    "tokenStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add_bos", "add_eos", "separator_policy", "sequence_length", "truncation", "packing", "sampling", "workers"],
      "properties": {
        "add_bos": {"type": "boolean"},
        "add_eos": {"type": "boolean"},
        "separator_policy": {"enum": ["none", "eos"]},
        "sequence_length": {"type": "integer", "minimum": 64},
        "truncation": {"enum": ["left", "right", "error"]},
        "packing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "cross_document", "remainder_policy"],
          "properties": {
            "enabled": {"type": "boolean"},
            "cross_document": {"type": "boolean"},
            "remainder_policy": {"enum": ["carry", "drop", "pad"]}
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "shuffle_algorithm", "shuffle_buffer_size", "seed"],
          "properties": {
            "mode": {"enum": ["without_replacement", "with_replacement"]},
            "shuffle_algorithm": {"type": "string", "minLength": 1},
            "shuffle_buffer_size": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"}
          }
        },
        "workers": {"type": "integer", "minimum": 0}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "learning_rate", "warmup", "checkpoint_every_steps", "save_optimizer_state"],
      "properties": {
        "precision": {"enum": ["auto", "fp32", "fp16", "bf16"]},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "warmup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "value"],
          "properties": {
            "unit": {"enum": ["ratio", "steps", "tokens"]},
            "value": {"type": "number", "minimum": 0}
          }
        },
        "checkpoint_every_steps": {"type": "integer", "minimum": 1},
        "save_optimizer_state": {"type": "boolean"}
      }
    },
    "checkpointSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "metric_id", "direction", "tie_breaker"],
      "properties": {
        "rule": {"enum": ["fixed_step", "metric_best", "last_checkpoint", "early_stopping"]},
        "metric_id": {"type": ["string", "null"]},
        "direction": {"enum": ["min", "max", "none"]},
        "tie_breaker": {"enum": ["earliest_step", "latest_step", "lowest_artifact_hash"]}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id", "metric_version", "target_artifact", "baseline_id",
        "comparison_type", "operator", "threshold", "aggregation", "required", "missing_data_policy"
      ],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "metric_version": {"type": "string", "minLength": 1},
        "target_artifact": {"type": "string", "minLength": 1},
        "baseline_id": {"type": "string", "minLength": 1},
        "comparison_type": {"enum": ["absolute_value", "absolute_delta", "relative_delta", "ratio", "distribution_test"]},
        "operator": {"enum": [">", ">=", "<", "<=", "=="]},
        "threshold": {"type": "number"},
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "method"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1}
          }
        },
        "required": {"type": "boolean"},
        "missing_data_policy": {"enum": ["fail", "invalid", "ignore_optional"]}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_tokens", "temperature", "top_p", "top_k", "seed", "context_length", "stream"],
      "properties": {
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "top_k": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"},
        "context_length": {"type": "integer", "minimum": 64},
        "stream": {"type": "boolean"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["smoke_reference", "parent_baseline", "matched_control", "external_anchor"]},
        "source": {"enum": ["model_revision", "phase_parent", "artifact", "control_run"]},
        "model_id": {"type": "string"},
        "revision": {"type": "string"},
        "phase_id": {"type": "string"},
        "artifact_id": {"type": "string"},
        "parent_baseline": {"type": "string"},
        "intervention": {"type": "string"},
        "matched_to": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "token_budget": {"type": "integer", "minimum": 1},
        "resource_class": {"type": "string"},
        "control_run_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "model_revision"}}, "required": ["source"]},
          "then": {"required": ["model_id", "revision"]}
        },
        {
          "if": {"properties": {"source": {"const": "phase_parent"}}, "required": ["source"]},
          "then": {"required": ["phase_id"]}
        },
        {
          "if": {"properties": {"source": {"const": "artifact"}}, "required": ["source"]},
          "then": {"required": ["artifact_id"]}
        },
        {
          "if": {"properties": {"source": {"const": "control_run"}}, "required": ["source"]},
          "then": {"required": ["control_run_id"]}
        },
        {
          "if": {"properties": {"role": {"const": "matched_control"}}, "required": ["role"]},
          "then": {"required": ["parent_baseline", "intervention", "matched_to", "seeds", "token_budget", "resource_class", "control_run_id"]}
        }
      ]
    }
  }
}

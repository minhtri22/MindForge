{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data_manifest.schema.json",
  "title": "DataManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "sources", "transforms", "splits", "token_streams", "freshness_registry", "manifest_hash"],
  "properties": {
    "manifest_version": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "adapter", "snapshot", "content_sha256",
          "license_policy", "privacy_policy", "secret_scan_policy"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "snapshot": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license_policy": {"type": "string", "minLength": 1},
          "privacy_policy": {"type": "string", "minLength": 1},
          "secret_scan_policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "transforms": {"type": "array", "items": {"type": "object"}},
    "splits": {"type": "array", "items": {"type": "object"}},
    "token_streams": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "tokenizer_hash", "sequence_length", "packing", "sampling", "stream_hash"],
        "properties": {
          "phase_id": {"type": "string", "minLength": 1},
          "tokenizer_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sequence_length": {"type": "integer", "minimum": 1},
          "packing": {"type": "object"},
          "sampling": {"type": "object"},
          "stream_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "freshness_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_ids", "fixture_set_ids"],
      "properties": {
        "split_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "fixture_set_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
